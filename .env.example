# Copy this file to ".env" for local use. On Replit, do NOT create .env;
# add each of these in the Secrets tool instead.
# NEVER commit the real values to GitHub or share them with anyone.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Optional: your test server ID. When set, slash commands update instantly
# in that server. Leave empty to register commands globally (can take up to an hour).
GUILD_ID=

# Port for the health-check web server (Replit sets this automatically)
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info
